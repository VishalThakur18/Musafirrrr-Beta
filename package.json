{
  "name": "musafirrrr",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "Static site. npm is only needed to rebuild assets/css/tailwind.css and assets/js/app.min.js before deploying.",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -c src/config/tailwind.config.js -i assets/css/tailwind.input.css -o assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c src/config/tailwind.config.js -i assets/css/tailwind.input.css -o assets/css/tailwind.css --watch",
    "build:js": "node scripts/build-js.cjs",
    "check:js": "node scripts/build-js.cjs --check",
    "test": "node --test \"tests/*.test.cjs\""
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tailwindcss": "^3.4.17"
  }
}
